@page "/runs/detail/{Id:int}"
@using SkiTelemetry_Web.Services
@using SkiTelemetry_Core
@inject RunService RunService
@rendermode InteractiveServer
@code {
    private string activeTab = "summary"; // Tab di default
}





<div class="container-fluid p-2 p-md-4" data-bs-theme="dark">
    @if (run == null)
    {
        <div class="spinner-border text-primary" role="status"></div>
    }
    else
    {
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="runs">Elenco</a></li>
                <li class="breadcrumb-item active">Run #@Id</li>
            </ol>
        </nav>

        <div class="card bg-dark border-secondary mb-4">
            <div class="card-body">
                <h2 class="card-title text-primary">Analisi Sessione: @run.FileName</h2>
                <h5 class="text-light">Atleta: @run.Athlete?.FirstName @run.Athlete?.LastName</h5>
                <p class="text-muted">Data: @run.UploadDate.ToString("g")</p>
            </div>
        </div>
        <ul class="nav nav-pills nav-justified mb-4" role="tablist">
            <li class="nav-item">
                <button class="nav-link @(activeTab == "summary" ? "active" : "")" @onclick='() => activeTab = "summary"'>
                    <i class="bi bi-speedometer2"></i> Riepilogo
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == "turns" ? "active" : "")" @onclick='() => activeTab = "turns"'>
                    <i class="bi bi-p-circle"></i> Analisi Curve @*(@detectedTurns.Count)*@
                </button>
            </li>
        </ul>

        @if (activeTab == "summary")
        {
            <div class="row g-3">
                <div class="col-6 col-md-3 text-center">
                    <div class="p-3 border border-secondary rounded bg-dark">
                        <small class="text-muted">Media Angolo</small>
                        <h3 class="text-primary">@detectedTurns.Average(t => t.EdgeAngle)?.ToString("F1")°</h3>
                    </div>
                </div>
                <div class="col-6 col-md-3 text-center">
                    <div class="p-3 border border-secondary rounded bg-dark">
                        <small class="text-muted">Max G-Force</small>
                        <h3 class="text-danger">@detectedTurns.Max(t => t.GForce)?.ToString("F2")</h3>
                    </div>
                </div>
                <div class="col-6 col-md-3 text-center">
                    <div class="p-3 border border-secondary rounded bg-dark">
                        <small class="text-muted">Carving Index</small>
                        <h3 class="text-warning">@detectedTurns.Average(t => t.CarvingIndex)?.ToString("F0")%</h3>
                    </div>
                </div>
                <div class="col-6 col-md-3 text-center">
                    <div class="p-3 border border-secondary rounded bg-dark">
                        <small class="text-muted">Durata Totale</small>
                        <h3 class="text-info">@((telemetryData.LastOrDefault()?.Timestamp - telemetryData.FirstOrDefault()?.Timestamp) / 1000)s</h3>
                    </div>
                </div>
            </div>
        }
        @if (activeTab == "turns")
        {
            <div class="row gx-0">
                <div style="display: table; table-layout: fixed; width: 100%;">
                    <div style="display: table-cell;">
                        <div class="d-flex flex-nowrap py-2"
                             style="overflow-x: auto; -webkit-overflow-scrolling: touch; gap: 1rem; scroll-snap-type: x mandatory;">

                            @foreach (var (turn, index) in detectedTurns.Select((t, i) => (t, i)))
                            {
                                <div class="card bg-dark border-primary flex-shrink-0"
                                     style="width: 100%; max-width: 340px; scroll-snap-align: start; white-space: normal;">

                                    <div class="card-header bg-primary text-white py-2 d-flex justify-content-between align-items-center">
                                        <span class="fw-bold">Curva #@(index + 1)</span>
                                        <span class="badge bg-black bg-opacity-25">Shape: @turn.Shape?.ToString("F0")%</span>
                                    </div>

                                    <div class="card-body p-3">
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="small text-muted">Max Roll</span>
                                            <span class="fw-bold text-info">@turn.EdgeAngle?.ToString("F1")°</span>
                                        </div>

                                        <div class="progress" style="height: 6px; background-color: #222;">
                                            <div class="progress-bar bg-info"
                                                 style="width: @Math.Clamp((turn.EdgeAngle ?? 0) / 60 * 100, 0, 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture)%">
                                            </div>
                                        </div>

                                        <div class="row g-0 text-center border-top border-secondary pt-2 mt-3">
                                            <div class="col-3 border-end border-secondary">
                                                <div class="text-muted" style="font-size: 0.6rem;">RADIUS</div>
                                                <div class="fw-bold small">@turn.Radius?.ToString("F1")</div>
                                            </div>
                                            <div class="col-3 border-end border-secondary">
                                                <div class="text-muted" style="font-size: 0.6rem;">G-FORCE</div>
                                                <div class="fw-bold small">@turn.GForce?.ToString("F1")</div>
                                            </div>
                                            <div class="col-3 border-end border-secondary">
                                                <div class="text-muted" style="font-size: 0.6rem;">BUILD</div>
                                                <div class="fw-bold small">@turn.ProgressiveEdgeBuild?.ToString("F0")%</div>
                                            </div>
                                            <div class="col-3">
                                                <div class="text-muted" style="font-size: 0.6rem;">CARVING</div>
                                                <div class="fw-bold small">@turn.CarvingIndex?.ToString("F0")%</div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private SkiRun? run;
    private List<SkiDataPoint> telemetryData = new();
    private List<SkiTurn> detectedTurns = new();
    

    protected override async Task OnInitializedAsync()
    {
        var result = await RunService.GetRunDetailsBinaryAsync(Id);
        run = result.Run;
        telemetryData = result.Telemetry;

        if (run != null && telemetryData.Any())
        {
            AnalyzeRun();
        }
    }
    private void AnalyzeRun()
    {
        var detector = new TurnDetector();

        // 1. Sottoscrizione all'evento come definito nel tuo codice
        detector.OnTurnCompleted += (s, turn) =>
        {
            System.Diagnostics.Debug.WriteLine($"[RunDetail] Turn detected:{turn}");
            detectedTurns.Add(turn);
        };

        // 2. Configurazione metriche (HashSet<MonitorMode>)
        detector.RequestedMetrics.Add(MonitorMode.EdgeAngle);
        detector.RequestedMetrics.Add(MonitorMode.GForce);
        detector.RequestedMetrics.Add(MonitorMode.TurnRadius);
        detector.RequestedMetrics.Add(MonitorMode.EarlyEdging);
        detector.RequestedMetrics.Add(MonitorMode.ProgressiveEdgeBuild);
        detector.RequestedMetrics.Add(MonitorMode.TurnShape);
        detector.RequestedMetrics.Add(MonitorMode.CarvingIndex);
        detector.RequestedMetrics.Add(MonitorMode.EdgeSimilarity);

        // 3. Accoppiamento Left/Right per il metodo AddPoints(left, right)
        // Raggruppiamo per timestamp per essere sicuri di passare i piedi sincronizzati

        SkiDataPoint? leftDataPoint = null;
        SkiDataPoint? rightDataPoint = null;

        foreach (var point in telemetryData)
        {

            if (point.Side == SensorSide.Left)
            {
                leftDataPoint = point;
            }
            else if (point.Side == SensorSide.Right)
            {
                rightDataPoint = point;
            }
            if (leftDataPoint == null || rightDataPoint == null)
            {
                continue;
            }
            System.Diagnostics.Debug.WriteLine($"[RunDetail] adding Points: [{leftDataPoint}] - [{rightDataPoint}]");
            detector.AddPoints(leftDataPoint, rightDataPoint);
            leftDataPoint = null;
            rightDataPoint = null;
        }
    }
}