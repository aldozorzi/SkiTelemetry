<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:SkiTelemetry_Analyst.Helpers"
             xmlns:controls="clr-namespace:SkiTelemetry_Analyst.Controls"
             xmlns:runs="clr-namespace:SkiTelemetry_Analyst.Views.Runs"
             x:Class="SkiTelemetry_Analyst.Views.Runs.RunDetailPage"
             Shell.NavBarIsVisible="False"
             Title="">
    <ContentPage.Resources>
        <ResourceDictionary>
            <helpers:AngleToPercentConverter x:Key="AngleToPercentConverter" />
            <helpers:PercentToRatioConverter x:Key="PercentToRatioConverter" />
            <helpers:FootToItalianConverter x:Key="FootToItalianConverter" />
            <helpers:GForceToPercentConverter x:Key="GForceToPercentConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2B0A4E" Offset="0.0" />
            <GradientStop Color="#3D0F55" Offset="0.55" />
            <GradientStop Color="#5C1C49" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, Auto, Auto, *" Padding="20,20,20,10">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="2" Margin="4,4,4,16">
            <Label Text="SKINETIK" FontSize="11" CharacterSpacing="3" TextColor="#B9A3D6" />
            <Label x:Name="LblRunName"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="White"
                   Text="CARICAMENTO..." />
            <Label x:Name="LblDate"
                   FontSize="13"
                   TextColor="#B9A3D6" />
        </VerticalStackLayout>

        <!-- Stat chips -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *, *, *" ColumnSpacing="10" Margin="0,0,0,16">
            <Border Grid.Column="0" Padding="8" Stroke="#30FFFFFF" StrokeThickness="1" BackgroundColor="#1AFFFFFF">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                    <Label Text="INDICE MED" FontSize="9" CharacterSpacing="1" TextColor="#B9A3D6" HorizontalOptions="Center" />
                    <Label x:Name="LblPerformanceIndex" FontSize="17" FontAttributes="Bold" TextColor="White" Text="0%" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="1" Padding="8" Stroke="#30FFFFFF" StrokeThickness="1" BackgroundColor="#1AFFFFFF">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                    <Label Text="MAX °" FontSize="9" CharacterSpacing="1" TextColor="#B9A3D6" HorizontalOptions="Center" />
                    <Label x:Name="LblMaxAngle" FontSize="17" FontAttributes="Bold" TextColor="White" Text="0°" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="2" Padding="8" Stroke="#30FFFFFF" StrokeThickness="1" BackgroundColor="#1AFFFFFF">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                    <Label Text="MAX G" FontSize="9" CharacterSpacing="1" TextColor="#B9A3D6" HorizontalOptions="Center" />
                    <Label x:Name="LblMaxG" FontSize="17" FontAttributes="Bold" TextColor="White" Text="0.0" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="3" Padding="8" Stroke="#30FFFFFF" StrokeThickness="1" BackgroundColor="#1AFFFFFF">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                    <Label Text="CURVE" FontSize="9" CharacterSpacing="1" TextColor="#B9A3D6" HorizontalOptions="Center" />
                    <Label x:Name="LblTurnCount" FontSize="17" FontAttributes="Bold" TextColor="White" Text="0" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Segmented control -->
        <Border Grid.Row="2" Stroke="#30FFFFFF" StrokeThickness="1" BackgroundColor="#1AFFFFFF"
                Padding="4" Margin="0,0,0,14" HorizontalOptions="Fill">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*, *" ColumnSpacing="4">
                <Border x:Name="BtnTabCurve" Grid.Column="0"
                        Padding="20,10"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="White">
                    <Label Text="CURVE" FontSize="12" FontAttributes="Bold"
                           TextColor="#2B0A4E" HorizontalOptions="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabCurve" />
                    </Border.GestureRecognizers>
                </Border>

                <Border x:Name="BtnTabGrafico" Grid.Column="1"
                        Padding="20,10"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="Transparent">
                    <Label Text="GRAFICO" FontSize="12" FontAttributes="Bold"
                           TextColor="#8E7BA8" HorizontalOptions="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabGrafico" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <CollectionView x:Name="TurnsCollection" SelectionMode="None" Margin="0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16" Stroke="#30FFFFFF" StrokeThickness="1"
                                BackgroundColor="#1AFFFFFF" StrokeShape="RoundRectangle 20">
                            <VerticalStackLayout Spacing="10">

                                <!-- Card header: index + direction / perf ring -->
                                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                    <VerticalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                        <Label Text="{Binding Index, StringFormat='CURVA {0:00}'}"
                                               FontSize="12" CharacterSpacing="2" TextColor="#B9A3D6" />
                                        <Border Padding="10,5" StrokeThickness="0"
                                                BackgroundColor="#33FFFFFF"
                                                HorizontalOptions="Start">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="10" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Foot, Converter={StaticResource FootToItalianConverter}}"
                                                   FontSize="12" FontAttributes="Bold" TextColor="White" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" Spacing="0"
                                                         HorizontalOptions="Center" VerticalOptions="Center">
                                        <Grid WidthRequest="120" HeightRequest="72"
                                              HorizontalOptions="Center" VerticalOptions="Center">
                                            <controls:PerfRingView Value="{Binding PerformanceIndex, TargetNullValue=0}"
                                                                   WidthRequest="120" HeightRequest="72"
                                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                            <Label Text="{Binding PerformanceIndex, StringFormat='{0:F0}%', TargetNullValue='0%'}"
                                                   FontSize="16" FontAttributes="Bold" TextColor="White"
                                                   HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,16" />
                                        </Grid>
                                        <Label Text="INDICE PERF" FontSize="8" CharacterSpacing="1"
                                               TextColor="#B9A3D6" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Roll / G bars -->
                                <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="ROLLIO MAX" FontSize="9" CharacterSpacing="1" TextColor="#B9A3D6" />
                                        <Label Text="{Binding EdgeAngle, StringFormat='{0:F0}°'}"
                                               FontSize="20" FontAttributes="Bold" TextColor="White" />
                                        <ProgressBar Progress="{Binding EdgeAngle, Converter={StaticResource AngleToPercentConverter}}"
                                                     ProgressColor="White" BackgroundColor="#33FFFFFF" HeightRequest="6" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="FORZA G" FontSize="9" CharacterSpacing="1" TextColor="#B9A3D6" />
                                        <Label Text="{Binding GForce, StringFormat='{0:F1} G'}"
                                               FontSize="20" FontAttributes="Bold" TextColor="White" />
                                        <ProgressBar Progress="{Binding GForce, Converter={StaticResource GForceToPercentConverter}}"
                                                     ProgressColor="White" BackgroundColor="#33FFFFFF" HeightRequest="6" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Mini stats -->
                                <Border Padding="12,10" Stroke="#22FFFFFF" StrokeThickness="1"
                                        BackgroundColor="#14FFFFFF">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="*, *, *, *">
                                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                                            <Label Text="SIMIL" FontSize="8" CharacterSpacing="1" TextColor="#B9A3D6" HorizontalOptions="Center"/>
                                            <Label Text="{Binding EdgeSimilarity, StringFormat='{0:F1}%'}" FontSize="13" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                                            <Label Text="ANTICIPO" FontSize="8" CharacterSpacing="1" TextColor="#B9A3D6" HorizontalOptions="Center"/>
                                            <Label Text="{Binding EarlyLoading, StringFormat='{0:F0}%'}" FontSize="13" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                                            <Label Text="COSTRUZ" FontSize="8" CharacterSpacing="1" TextColor="#B9A3D6" HorizontalOptions="Center"/>
                                            <Label Text="{Binding ProgressiveEdgeBuild, StringFormat='{0:F0}%'}" FontSize="13" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="2">
                                            <Label Text="TEMPO" FontSize="8" CharacterSpacing="1" TextColor="#B9A3D6" HorizontalOptions="Center"/>
                                            <Label Text="{Binding Duration, StringFormat='{0:F2}s'}" FontSize="13" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="50" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="Nessuna curva rilevata." TextColor="#D8CCE8" HorizontalTextAlignment="Center" />
                        <Label Text="Verifica che i dati binari siano corretti." FontSize="12" TextColor="#8E7BA8" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
            <runs:SkiChartView x:Name="SkiChart" IsVisible="False" />
        </Grid>
    </Grid>
</ContentPage>
