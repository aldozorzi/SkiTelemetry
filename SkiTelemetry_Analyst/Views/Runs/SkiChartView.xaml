<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="SkiTelemetry_Analyst.Views.Runs.SkiChartView"
             HeightRequest="360">
    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Toggle serie -->
        <ScrollView Grid.Row="0" Orientation="Horizontal"
                    HorizontalOptions="Center" 
                    VerticalOptions="Center"
                    HorizontalScrollBarVisibility="Never"
                    Margin="0,0,0,6">
            <HorizontalStackLayout x:Name="ToggleButtons" Spacing="5" Padding="2" VerticalOptions="Center" />
        </ScrollView>

        <!-- Canvas grafico -->
        <Border Grid.Row="1" Stroke="#2a2a2a" StrokeShape="RoundRectangle 10"
                BackgroundColor="#0f0f0f" Margin="0">
            <skia:SKCanvasView x:Name="ChartCanvas"
                               PaintSurface="OnPaintSurface"
                               EnableTouchEvents="True"
                               Touch="OnTouch" />
        </Border>

        <!-- Controlli zoom -->
        <HorizontalStackLayout Grid.Row="2" Spacing="8" Margin="0,6,0,0"
                               HorizontalOptions="Center">
            <Button Text="↺" ToolTipProperties.Text="Reset zoom"
                    Clicked="OnResetZoom"
                    FontSize="13" Padding="10,4"
                    BackgroundColor="#1e1e1e" TextColor="#aaa"
                    BorderColor="#333" BorderWidth="1" CornerRadius="8"/>
            <Button Text="＋" Clicked="OnZoomIn"
                    FontSize="13" Padding="10,4"
                    BackgroundColor="#1e1e1e" TextColor="#aaa"
                    BorderColor="#333" BorderWidth="1" CornerRadius="8"/>
            <Button Text="－" Clicked="OnZoomOut"
                    FontSize="13" Padding="10,4"
                    BackgroundColor="#1e1e1e" TextColor="#aaa"
                    BorderColor="#333" BorderWidth="1" CornerRadius="8"/>
        </HorizontalStackLayout>
    </Grid>
</ContentView>