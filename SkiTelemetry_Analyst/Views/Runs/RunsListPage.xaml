<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SkiTelemetry_Analyst.Views.Runs.RunsListPage"
             Title="">
    <Grid RowDefinitions="Auto, Auto, *" Padding="30, 30">

        <Label Grid.Row="0" Text="STORICO SESSIONI" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />

        <Button 
            x:Name="BtnSyncAll"
            Grid.Row="1" 
            Text="SINCRONIZZA TUTTE" 
            Clicked="OnSyncAllClicked"
            BackgroundColor="SeaGreen"
            TextColor="White"
            Margin="0,10,0,20"
            HeightRequest="45" 
            IsVisible="false"/>

        <CollectionView Grid.Row="2" x:Name="RunsCollection" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10,15" ColumnDefinitions="*, *, Auto, Auto" ColumnSpacing="10">

                        <Label Grid.Column="0" Text="{Binding RunName}" FontAttributes="Bold" VerticalOptions="Center" />

                        <Label Grid.Column="1" Text="{Binding FormattedDate}" FontSize="13" TextColor="Gray" VerticalOptions="Center" />

                        <Button Grid.Column="2" 
                            Text="👁" 
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ViewCommand}"
                            CommandParameter="{Binding .}"
                            BackgroundColor="LightGray"
                            TextColor="Black"
                            WidthRequest="45" />

                        <Button Grid.Column="3" 
                            Text="☁" 
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SyncCommand}"
                            CommandParameter="{Binding .}"
                            BackgroundColor="DeepSkyBlue"
                            TextColor="White"
                            WidthRequest="45" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>