<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:SkiTelemetry_Analyst.Helpers"
             x:Class="SkiTelemetry_Analyst.Views.Runs.RunsListPage"
             Title="">
    <ContentPage.Resources>
        <ResourceDictionary>
            <helpers:InvertBoolConverter x:Key="InvertBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto, Auto, *" Padding="30, 30">

        <Label Grid.Row="0" Text="STORICO SESSIONI" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />

        <Button 
            x:Name="BtnSyncAll"
            Grid.Row="1" 
            Text="SINCRONIZZA TUTTE" 
            Clicked="OnSyncAllClicked"
            BackgroundColor="CornflowerBlue"
            TextColor="White"
            Margin="0,10,0,20"
            HeightRequest="45" 
            IsVisible="false"/>

        <CollectionView Grid.Row="2" x:Name="RunsCollection" SelectionMode="None" ItemsSource="{Binding Runs}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 10" StrokeThickness="0" Margin="0,8" Padding="15" BackgroundColor="#2A2A2A">
                        <VerticalStackLayout Spacing="10">

                            <Label Text="{Binding DisplayTitle}" FontSize="16" FontAttributes="Bold" TextColor="White" />

                            <Label Text="{Binding Notes}" FontSize="13" TextColor="LightGray" 
                           LineBreakMode="WordWrap" MaxLines="3"
                           IsVisible="{Binding HasNotes}" />

                            <BoxView HeightRequest="1" Color="#444" Margin="0,5" />

                            <Grid ColumnDefinitions="*, *, *, *, *" ColumnSpacing="10">
                                <Button Grid.Column="0" Text="👁" Command="{Binding BindingContext.ViewCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding .}" BackgroundColor="#555"/>

                                <Button Grid.Column="1" Text="✎" Command="{Binding BindingContext.EditNotesCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding .}" BackgroundColor="Goldenrod"/>

                                <Button Grid.Column="2" Text="🗑" Command="{Binding BindingContext.DeleteCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding .}" BackgroundColor="IndianRed" />

                                <Button Grid.Column="3" Text="☁" Command="{Binding BindingContext.SyncCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding .}" IsVisible="{Binding IsLocal}" BackgroundColor="CornflowerBlue"/>
                                <Label Grid.Column="3" Text="☁"  TextColor="CornflowerBlue" VerticalOptions="Center" HorizontalOptions="Fill" IsVisible="{Binding IsLocal, Converter={StaticResource InvertBoolConverter}}" HorizontalTextAlignment="Center"/>

                                <Button Grid.Column="4" Text="📄" TextColor="DarkSlateGray" Command="{Binding BindingContext.ExportCsvCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding .}" BackgroundColor="DarkSeaGreen"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border StrokeThickness="0" 
                BackgroundColor="{AppThemeBinding Dark={StaticResource Gray900}, Light={StaticResource Gray200}}" 
                Padding="20" 
                VerticalOptions="Center" 
                IsVisible="{Binding IsLoading}"
                Grid.RowSpan="3"
                HorizontalOptions="Center"
                >
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>

            <VerticalStackLayout Grid.Row="0" Grid.RowSpan="3" >
                <ActivityIndicator IsRunning="{Binding IsLoading}" 
                   Color="DeepSkyBlue" 
                   WidthRequest="50" 
                   HeightRequest="50" />
                <Label Text="Caricamento sessione..." 
               TextColor="White" 
               HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>