<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SkiTelemetry_Analyst.Views.MainPage"
             Shell.NavBarIsVisible="False"
             Title="">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2B0A4E" Offset="0.0" />
            <GradientStop Color="#3D0F55" Offset="0.55" />
            <GradientStop Color="#5C1C49" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="20,20,20,30">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center" Margin="4,4,4,4">
                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                    <Label Text="SKINETIK" FontSize="11" CharacterSpacing="3" TextColor="#B9A3D6" />
                </VerticalStackLayout>
                <Border Grid.Column="1"
                        WidthRequest="48" HeightRequest="48"
                        Stroke="#30FFFFFF" StrokeThickness="1"
                        BackgroundColor="#1AFFFFFF"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Label Text="⚙" FontSize="22" TextColor="White"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSettingsClicked" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>

            <!-- Pair button (visible until sensors are paired) -->
            <VerticalStackLayout x:Name="ConfigView" Spacing="0">
                <Border Stroke="#30FFFFFF" StrokeThickness="1"
                        BackgroundColor="#B3E8890C" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                        <Border WidthRequest="48" HeightRequest="48"
                                BackgroundColor="#33FFFFFF" StrokeThickness="0"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="🎿" FontSize="20"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Accoppia Sensori" FontSize="17" FontAttributes="Bold" TextColor="White" />
                            <Label Text="Connetti i sensori di movimento" FontSize="13" TextColor="#F5E9CE" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPairSensorsClicked" />
                    </Border.GestureRecognizers>
                </Border>
            </VerticalStackLayout>

            <!-- Monitoring + session actions (visible when paired) -->
            <VerticalStackLayout x:Name="ActiveView" IsVisible="False" Spacing="16">

                <!-- Hidden state holders (logic lives in code-behind).
                     Kept in a collapsed container: code toggles the buttons'
                     IsVisible, which the cards below observe via x:Reference. -->
                <VerticalStackLayout IsVisible="False" HeightRequest="0" WidthRequest="0">
                    <Button x:Name="BtnPair" Clicked="OnPairSensorsClicked" />
                    <Button x:Name="BtnScan" Clicked="OnScanClicked" />
                    <Button x:Name="BtnQuickCalibrate" Text="CALIBRA ORA" Clicked="OnQuickCalibrateClicked" />
                </VerticalStackLayout>

                <!-- Monitoring card -->
                <Border Stroke="#30FFFFFF" StrokeThickness="1"
                        BackgroundColor="#1AFFFFFF" Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <VerticalStackLayout x:Name="DataContainer" IsVisible="True" Spacing="10">
                        <Label Text="MONITORAGGIO" FontSize="11" CharacterSpacing="3" TextColor="#B9A3D6" />
                        <Picker x:Name="ModePicker"
                                SelectedIndexChanged="OnModeChanged"
                                Title="Seleziona cosa monitorare"
                                TitleColor="#B9A3D6"
                                TextColor="White" />

                        <HorizontalStackLayout x:Name="EdgeAngleDisplay" IsVisible="False" HorizontalOptions="Center" Spacing="40">
                            <VerticalStackLayout>
                                <Label Text="ANGOLO LAMINA" FontSize="11" CharacterSpacing="2" TextColor="#B9A3D6" HorizontalOptions="Center"/>
                                <Label x:Name="LblEdgeAngle" Text="0.0°" FontSize="54" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout x:Name="EdgeSimilarityDisplay" IsVisible="False" HorizontalOptions="Center" Spacing="40">
                            <VerticalStackLayout>
                                <Label Text="PARALLELISMO LAMINE" FontSize="11" CharacterSpacing="2" TextColor="#B9A3D6" HorizontalOptions="Center"/>
                                <Label x:Name="LblEdgeSimilarity" Text="0%" FontSize="54" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout x:Name="GForceDisplay" IsVisible="False" HorizontalOptions="Center" Spacing="40">
                            <VerticalStackLayout>
                                <Label Text="FORZA G MAX" FontSize="11" CharacterSpacing="2" TextColor="#B9A3D6" HorizontalOptions="Center"/>
                                <Label x:Name="LblGForce" Text="0.0 G" FontSize="54" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout x:Name="RadiusDisplay" IsVisible="False" HorizontalOptions="Center" Spacing="40">
                            <VerticalStackLayout>
                                <Label Text="RAGGIO" FontSize="11" CharacterSpacing="2" TextColor="#B9A3D6" HorizontalOptions="Center"/>
                                <Label x:Name="LblRadius" Text="0 m" FontSize="54" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout x:Name="EarlyLoadingDisplay" IsVisible="False" HorizontalOptions="Center" Spacing="40">
                            <VerticalStackLayout>
                                <Label Text="CARICO ANTICIPATO" FontSize="11" CharacterSpacing="2" TextColor="#B9A3D6" HorizontalOptions="Center"/>
                                <Label x:Name="LblEarlyLoading" Text="0%" FontSize="54" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout x:Name="ProgressiveBuildDisplay" IsVisible="False" HorizontalOptions="Center" Spacing="40">
                            <VerticalStackLayout>
                                <Label Text="PROGRESSIONE LAMINA" FontSize="11" CharacterSpacing="2" TextColor="#B9A3D6" HorizontalOptions="Center"/>
                                <Label x:Name="LblProgressiveBuild" Text="0%" FontSize="54" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout x:Name="TurnShapeDisplay" IsVisible="False" HorizontalOptions="Center" Spacing="40">
                            <VerticalStackLayout>
                                <Label Text="FORMA CURVA" FontSize="11" CharacterSpacing="2" TextColor="#B9A3D6" HorizontalOptions="Center"/>
                                <Label x:Name="LblTurnShape" Text="0%" FontSize="54" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout x:Name="PerformanceIndexDisplay" IsVisible="False" HorizontalOptions="Center" Spacing="40">
                            <VerticalStackLayout>
                                <Label Text="INDICE PRESTAZIONE" FontSize="11" CharacterSpacing="2" TextColor="#B9A3D6" HorizontalOptions="Center"/>
                                <Label x:Name="LblPerformanceIndex" Text="0%" FontSize="54" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout x:Name="TurnTimeDisplay" IsVisible="False" HorizontalOptions="Center" Spacing="40">
                            <VerticalStackLayout>
                                <Label Text="TEMPO CURVA" FontSize="11" CharacterSpacing="2" TextColor="#B9A3D6" HorizontalOptions="Center"/>
                                <Label x:Name="LblTurnTime" Text="0s" FontSize="54" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <VerticalStackLayout x:Name="DebugDataDisplay" IsVisible="False" Spacing="5" Padding="5">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="SENSORE SINISTRO" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                                    <Border Padding="5" Stroke="#30FFFFFF" BackgroundColor="#1AFFFFFF">
                                        <VerticalStackLayout>
                                            <Label Text="ACCELEROMETRO (m/s²)" FontSize="10" FontAttributes="Bold" Margin="0,5,0,2"/>
                                            <Label x:Name="LblAccXL" Text="X: 0.00" FontSize="12" FontFamily="monospace"/>
                                            <Label x:Name="LblAccYL" Text="Y: 0.00" FontSize="12" FontFamily="monospace"/>
                                            <Label x:Name="LblAccZL" Text="Z: 0.00" FontSize="12" FontFamily="monospace"/>

                                            <Label Text="GIROSCOPIO (°/s)" FontSize="10" FontAttributes="Bold" Margin="0,5,0,2"/>
                                            <Label x:Name="LblGyrXL" Text="X: 0.0" FontSize="12" FontFamily="monospace"/>
                                            <Label x:Name="LblGyrYL" Text="Y: 0.0" FontSize="12" FontFamily="monospace"/>
                                            <Label x:Name="LblGyrZL" Text="Z: 0.0" FontSize="12" FontFamily="monospace"/>

                                            <Label Text="INCLINAZIONE" FontSize="10" FontAttributes="Bold" Margin="0,5,0,2"/>
                                            <Label x:Name="LblRollL" Text="0.0°" FontSize="12" FontAttributes="Bold"/>
                                            <Label Text="FORZA G" FontSize="10" FontAttributes="Bold" Margin="0,5,0,2"/>
                                            <Label x:Name="LblGForceL" Text="0.0" FontSize="12" FontAttributes="Bold"/>
                                        </VerticalStackLayout>
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="SENSORE DESTRO" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                                    <Border Padding="5" Stroke="#30FFFFFF" BackgroundColor="#1AFFFFFF">
                                        <VerticalStackLayout>
                                            <Label Text="ACCELEROMETRO (m/s²)" FontSize="10" FontAttributes="Bold" Margin="0,5,0,2"/>
                                            <Label x:Name="LblAccXR" Text="X: 0.00" FontSize="12" FontFamily="monospace"/>
                                            <Label x:Name="LblAccYR" Text="Y: 0.00" FontSize="12" FontFamily="monospace"/>
                                            <Label x:Name="LblAccZR" Text="Z: 0.00" FontSize="12" FontFamily="monospace"/>

                                            <Label Text="GIROSCOPIO (°/s)" FontSize="10" FontAttributes="Bold" Margin="0,5,0,2"/>
                                            <Label x:Name="LblGyrXR" Text="X: 0.0" FontSize="12" FontFamily="monospace"/>
                                            <Label x:Name="LblGyrYR" Text="Y: 0.0" FontSize="12" FontFamily="monospace"/>
                                            <Label x:Name="LblGyrZR" Text="Z: 0.0" FontSize="12" FontFamily="monospace"/>

                                            <Label Text="INCLINAZIONE" FontSize="10" FontAttributes="Bold" Margin="0,5,0,2"/>
                                            <Label x:Name="LblRollR" Text="0.0°" FontSize="12" FontAttributes="Bold"/>
                                            <Label Text="FORZA G" FontSize="10" FontAttributes="Bold" Margin="0,5,0,2"/>
                                            <Label x:Name="LblGForceR" Text="0.0" FontSize="12" FontAttributes="Bold"/>
                                        </VerticalStackLayout>
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Status pill -->
                        <Border Stroke="#3355FF88" StrokeThickness="1"
                                BackgroundColor="#332E7D32"
                                Padding="14,8"
                                HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Label Text="●" FontSize="12" TextColor="#4ADE80" VerticalOptions="Center" />
                                <Label x:Name="StatusLabel" Text="Stato: pronto per la sessione"
                                       FontSize="13" TextColor="White" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Start Session -->
                <Border x:Name="ScanCard"
                        IsVisible="{Binding Source={x:Reference BtnScan}, Path=IsVisible}"
                        Stroke="#30FFFFFF" StrokeThickness="1"
                        BackgroundColor="#B37E57C2" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                        <Border WidthRequest="48" HeightRequest="48"
                                BackgroundColor="#33FFFFFF" StrokeThickness="0"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="▶" FontSize="20" TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Avvia Sessione" FontSize="17" FontAttributes="Bold" TextColor="White" />
                            <Label Text="Inizia la cattura del movimento" FontSize="13" TextColor="#E4D8F2" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnScanClicked" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Calibrate Sensors -->
                <Border x:Name="CalCard"
                        IsVisible="{Binding Source={x:Reference BtnQuickCalibrate}, Path=IsVisible}"
                        Stroke="#30FFFFFF" StrokeThickness="1"
                        BackgroundColor="#B3E05A1E" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                        <Border WidthRequest="48" HeightRequest="48"
                                BackgroundColor="#33FFFFFF" StrokeThickness="0"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="🔧" FontSize="20"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Calibra Sensori" FontSize="17" FontAttributes="Bold" TextColor="White" />
                            <Label Text="{Binding Source={x:Reference BtnQuickCalibrate}, Path=Text}"
                                   FontSize="13" TextColor="#F5E3CE" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnQuickCalibrateClicked" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Stop session -->
                <VerticalStackLayout x:Name="BtnStopContainer" IsVisible="False" Spacing="0">
                    <Border Stroke="#30FFFFFF" StrokeThickness="1"
                            BackgroundColor="#B3D32F2F" Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="14" VerticalOptions="Center" HorizontalOptions="Center">
                            <Label Text="■" FontSize="20" TextColor="White" VerticalOptions="Center" />
                            <Label Text="STOP SESSIONE" FontSize="17" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStopClicked" />
                        </Border.GestureRecognizers>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- View Sessions -->
            <VerticalStackLayout x:Name="BtnHistoryContainer" Spacing="0">
                <Border Stroke="#30FFFFFF" StrokeThickness="1"
                        BackgroundColor="#B3A02080" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                        <Border WidthRequest="48" HeightRequest="48"
                                BackgroundColor="#33FFFFFF" StrokeThickness="0"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="☰" FontSize="20" TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Vedi Sessioni" FontSize="17" FontAttributes="Bold" TextColor="White" />
                            <Label Text="Sfoglia le registrazioni passate" FontSize="13" TextColor="#EFD8EA" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHistoryClicked" />
                    </Border.GestureRecognizers>
                </Border>
            </VerticalStackLayout>

            <!-- Login / Cloud Backup (visible only when no user ever logged in) -->
            <VerticalStackLayout x:Name="BtnLoginContainer" Spacing="0" IsVisible="False">
                <Border Stroke="#30FFFFFF" StrokeThickness="1"
                        BackgroundColor="#B34267F5" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                        <Border WidthRequest="48" HeightRequest="48"
                                BackgroundColor="#33FFFFFF" StrokeThickness="0"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="👤" FontSize="20"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Accedi" FontSize="17" FontAttributes="Bold" TextColor="White" />
                            <Label Text="Sincronizza le sessioni nel cloud" FontSize="13" TextColor="#D8E0F5" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLoginClicked" />
                    </Border.GestureRecognizers>
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
