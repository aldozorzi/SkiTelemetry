<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SkiTelemetry_Analyst.Views.MainPage"
             Shell.NavBarIsVisible="True"
             Title="">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30">

            <VerticalStackLayout x:Name="ConfigView" Spacing="15">
                <Label Text="ACCOPPIAMENTO SENSORI" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                <Button x:Name="BtnPair"
            Text="ACCOPPIA SENSORI" 
            Clicked="OnPairSensorsClicked" 
            BackgroundColor="Orange" 
            HeightRequest="60" />
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="ActiveView" IsVisible="False">
                <VerticalStackLayout x:Name="DataContainer" IsVisible="True" Spacing="10" >
                    <Picker x:Name="ModePicker" 
                        SelectedIndexChanged="OnModeChanged"
                        Title="Seleziona cosa monitorare">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Performance Index</x:String>
                                <x:String>Edge Angle</x:String>
                                <x:String>G-Force</x:String>
                                <x:String>Progressive Edge Build</x:String>
                                <x:String>Early Loading</x:String>
                                <x:String>Edge Similarity</x:String>
                                <x:String>Turn Time</x:String>
                                
                                
                                

                                <!--<x:String>Turn Radius</x:String>
                                <x:String>Turn Shape</x:String>
                                
                                

                                <x:String>Angle vs G-Force</x:String>
                                <x:String>Smoothness Index</x:String>
                                <x:String>Edge Engagement Rate</x:String>
                                <x:String>Line Choice</x:String>
                                <x:String>Load Distribution</x:String>
                                <x:String>Race Efficiency Index</x:String>-->
                                <x:String>Debug Data</x:String>

                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                    <HorizontalStackLayout x:Name="EdgeAngleDisplay" IsVisible="False" HorizontalOptions="Center" Spacing="40">
                        <VerticalStackLayout>
                            <Label Text="EDGE ANGLE" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Label x:Name="LblEdgeAngle" Text="0.0°" FontSize="24" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout x:Name="EdgeSimilarityDisplay" IsVisible="False" HorizontalOptions="Center" Spacing="40">
                        <VerticalStackLayout>
                            <Label Text="EDGE SIMILARITY" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Label x:Name="LblEdgeSimilarity" Text="0%" FontSize="24" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout x:Name="GForceDisplay" IsVisible="False" HorizontalOptions="Center" Spacing="40">
                        <VerticalStackLayout>
                            <Label Text="MAX G-FORCE" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Label x:Name="LblGForce" Text="0.0 G" FontSize="24" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout x:Name="RadiusDisplay" IsVisible="False" HorizontalOptions="Center" Spacing="40">
                        <VerticalStackLayout>
                            <Label Text="Radius" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Label x:Name="LblRadius" Text="0 m" FontSize="24" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout x:Name="EarlyLoadingDisplay" IsVisible="False" HorizontalOptions="Center" Spacing="40">
                        <VerticalStackLayout>
                            <Label Text="Early Loading" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Label x:Name="LblEarlyLoading" Text="0%" FontSize="24" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout x:Name="ProgressiveBuildDisplay" IsVisible="False" HorizontalOptions="Center" Spacing="40">
                        <VerticalStackLayout>
                            <Label Text="Progressive Edge Build" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Label x:Name="LblProgressiveBuild" Text="0%" FontSize="24" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout x:Name="TurnShapeDisplay" IsVisible="False" HorizontalOptions="Center" Spacing="40">
                        <VerticalStackLayout>
                            <Label Text="Turn Shape" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Label x:Name="LblTurnShape" Text="0%" FontSize="24" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout x:Name="PerformanceIndexDisplay" IsVisible="False" HorizontalOptions="Center" Spacing="40">
                        <VerticalStackLayout>
                            <Label Text="Performance Index" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Label x:Name="LblPerformanceIndex" Text="0%" FontSize="24" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout x:Name="TurnTimeDisplay" IsVisible="False" HorizontalOptions="Center" Spacing="40">
                        <VerticalStackLayout>
                            <Label Text="Turn Time" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Label x:Name="LblTurnTime" Text="0s" FontSize="24" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <VerticalStackLayout x:Name="DebugDataDisplay" IsVisible="False" Spacing="5" Padding="5">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="LEFT SENSOR" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                                <Border Padding="5" >
                                    <VerticalStackLayout>
                                        <Label Text="ACCELEROMETER (m/s²)" FontSize="10" FontAttributes="Bold" Margin="0,5,0,2"/>
                                        <Label x:Name="LblAccXL" Text="X: 0.00" FontSize="12" FontFamily="monospace"/>
                                        <Label x:Name="LblAccYL" Text="Y: 0.00" FontSize="12" FontFamily="monospace"/>
                                        <Label x:Name="LblAccZL" Text="Z: 0.00" FontSize="12" FontFamily="monospace"/>

                                        <Label Text="GYROSCOPE (°/s)" FontSize="10" FontAttributes="Bold" Margin="0,5,0,2"/>
                                        <Label x:Name="LblGyrXL" Text="X: 0.0" FontSize="12" FontFamily="monospace"/>
                                        <Label x:Name="LblGyrYL" Text="Y: 0.0" FontSize="12" FontFamily="monospace"/>
                                        <Label x:Name="LblGyrZL" Text="Z: 0.0" FontSize="12" FontFamily="monospace"/>

                                        <Label Text="ROLL" FontSize="10" FontAttributes="Bold" Margin="0,5,0,2"/>
                                        <Label x:Name="LblRollL" Text="0.0°" FontSize="12" FontAttributes="Bold"/>
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="RIGHT SENSOR" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                                <Border Padding="5" >
                                    <VerticalStackLayout>
                                        <Label Text="ACCELEROMETER (m/s²)" FontSize="10" FontAttributes="Bold" Margin="0,5,0,2"/>
                                        <Label x:Name="LblAccXR" Text="X: 0.00" FontSize="12" FontFamily="monospace"/>
                                        <Label x:Name="LblAccYR" Text="Y: 0.00" FontSize="12" FontFamily="monospace"/>
                                        <Label x:Name="LblAccZR" Text="Z: 0.00" FontSize="12" FontFamily="monospace"/>

                                        <Label Text="GYROSCOPE (°/s)" FontSize="10" FontAttributes="Bold" Margin="0,5,0,2"/>
                                        <Label x:Name="LblGyrXR" Text="X: 0.0" FontSize="12" FontFamily="monospace"/>
                                        <Label x:Name="LblGyrYR" Text="Y: 0.0" FontSize="12" FontFamily="monospace"/>
                                        <Label x:Name="LblGyrZR" Text="Z: 0.0" FontSize="12" FontFamily="monospace"/>

                                        <Label Text="ROLL" FontSize="10" FontAttributes="Bold" Margin="0,5,0,2"/>
                                        <Label x:Name="LblRollR" Text="0.0°" FontSize="12" FontAttributes="Bold"/>
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="20" VerticalOptions="Center" >
                        <Label x:Name="StatusLabel" Text="Stato: pronto per la sessione" HorizontalOptions="Center" />
                        <Button x:Name="BtnScan"
                        Text="AVVIA SESSIONE"
                        Clicked="OnScanClicked"
                        BackgroundColor="DeepSkyBlue" HeightRequest="60" />
                        <Button 
                            x:Name="BtnQuickCalibrate"
                        Text="CALIBRA SENSORI" 
                        Clicked="OnQuickCalibrateClicked" 
                        BackgroundColor="#FB8C00" 
                        TextColor="White" HeightRequest="60" />
                    </VerticalStackLayout>

                    
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="BtnStopContainer" IsVisible="false" VerticalOptions="Center" Margin="0,20,0,0">
                    <Button x:Name="BtnStop" 
                    Text="STOP SESSIONE" 
                    Clicked="OnStopClicked" 
                    BackgroundColor="Red" 
                    TextColor="White"
                    HeightRequest="60"
                     />
                </VerticalStackLayout>

                
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="BtnHistoryContainer" VerticalOptions="Center" Margin="0,0,0,0">

                <Button x:Name="BtnHistory"
        
                Text="VISUALIZZA SESSIONI"
                Clicked="OnHistoryClicked"
                BackgroundColor="DarkMagenta" HeightRequest="60" 
        
                    TextColor="White"/> 

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="⚙" 
                 Clicked="OnSettingsClicked" 
                 Order="Primary" />
    </ContentPage.ToolbarItems>

</ContentPage>
