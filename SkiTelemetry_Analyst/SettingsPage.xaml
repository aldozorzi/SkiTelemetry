<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SkiTelemetry_Analyst.SettingsPage"
             Title="Impostazioni">

    <VerticalStackLayout Padding="30" Spacing="25">

        <Label Text="GESTIONE SENSORI" 
               FontSize="20" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" />

        <Border Stroke="#E0E0E0"
                StrokeThickness="1"
                BackgroundColor="#F9F9F9"
                Padding="20">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="15"/>
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow Brush="Black"
                        Offset="2,2"
                        Radius="5"
                        Opacity="0.1" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="15">
                <Label Text="Pairing Attuale" 
                       FontAttributes="Bold" 
                       FontSize="16" />

                <Label Text="Se i sensori non si connettono o vuoi cambiare dispositivi, usa il tasto reset qui sotto." 
                       FontSize="13" 
                       TextColor="#666666" />

                <Button x:Name="BtnReset"
                        Text="RESET CONFIGURAZIONE"
                        BackgroundColor="#FF3B30"
                        TextColor="White"
                        FontAttributes="Bold"
                        Clicked="OnResetConfigClicked"
                        HeightRequest="50" />
            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>
</ContentPage>